# --- Core ---
DATABASE_URL=sqlite:///./dermavision.db
# For PostgreSQL: postgresql+psycopg2://dermavision:dermavision@localhost:5432/dermavision
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# --- Model ---
MODEL_PATH=weights/dermavision_effnet_b0.pt
# If true and no trained weights exist, returns clearly-labelled FAKE predictions so the UI can be demoed.
DEMO_MODE=true

# --- Chatbot (all optional: with no key, a built-in rule-based assistant is used) ---
# LLM_PROVIDER: auto | anthropic | gemini | ollama | none
LLM_PROVIDER=auto
# Free key (no card): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Fully local, no key: install Ollama, run `ollama pull llama3.2`, then set LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Paid (Anthropic):
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5
EMERGENCY_NUMBER=112

# --- Google sign-in (optional). Client ID from Google Cloud Console -> Credentials -> OAuth client ID (Web) ---
GOOGLE_CLIENT_ID=

# --- Password-reset email (optional). Empty = the reset link is printed in this terminal instead ---
# Gmail: turn on 2-Step Verification, create an "App password", then:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
